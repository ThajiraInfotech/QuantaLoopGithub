PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/quanta-loop
JWT_SECRET=replace-with-a-long-random-secret-min-16-chars
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Google OAuth (Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# SMTP email (OTP verification, password reset, and in-app notification alerts).
# Required for real delivery: SMTP_HOST + EMAIL_FROM.
# In development, messages are logged to the console if SMTP is unset.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app password>, EMAIL_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@quantaloop.com
EMAIL_FROM_NAME=Quanta Loop
SUPPORT_EMAIL=support@quantaloop.com
# When set, password-reset OTPs for admin accounts are delivered here instead.
# ADMIN_OTP_FORWARD_EMAIL=you@example.com
# OTP destination for admin panel password change confirmation.
# ADMIN_PASSWORD_CHANGE_OTP_EMAIL=root@example.com

# Optional image uploads (material photos).
# Prefer Cloudinary in production when set. Otherwise local disk is used;
# in production local disk requires API_PUBLIC_URL (public site/API origin).
API_PUBLIC_URL=http://localhost:5000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay one-time Orders checkout. Only these two keys are required.
# Test keys start with rzp_test_. Live keys start with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional. Webhooks improve reliability but UI verify still activates access.
# Dashboard → Settings → Webhooks → POST {API_PUBLIC_URL}/api/v1/subscriptions/webhook
# Subscribe: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=
# Legacy (unused for Orders checkout). Safe to leave empty.
RAZORPAY_PLAN_ID_ANNUAL_ACCESS=
RAZORPAY_PLAN_MAP=

# Optional temporary live smoke-test amount in paise (100 = ₹1).
# Remove or leave empty for normal ₹6,999. Restart API after change.
# ANNUAL_ACCESS_AMOUNT_PAISE=100
# Overseas annual membership in USD cents (9900 = $99). Empty = $99.
# ANNUAL_ACCESS_USD_AMOUNT_CENTS=9900

# Free trial days after onboarding completes (0 disables). Default 30.
MEMBERSHIP_TRIAL_DAYS=30

# Billing / GST — Quanta Loop is the invoice source of truth (Razorpay = payment only).
# Supplier place of supply uses app state codes (TN) mapped to GST numeric (33).
BILLING_SUPPLIER_STATE_CODE=TN
BILLING_SUPPLIER_STATE=Tamil Nadu
BILLING_SUPPLIER_GSTIN=33CABPA7492R1ZA
BILLING_SAC_CODE=998314
# Overseas: zero_rated_lut | manual_review | disabled (CA must confirm before live).
BILLING_EXPORT_TREATMENT=zero_rated_lut
BILLING_INVOICE_PREFIX=QL
BILLING_SELLER_LEGAL_NAME=Quanta Loop
BILLING_SELLER_OPERATED_BY=ASM Holdings
BILLING_SELLER_ADDRESS=
BILLING_INVOICE_DESCRIPTION=Annual platform access

# Web Push (browser notifications). Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@quantaloop.com
